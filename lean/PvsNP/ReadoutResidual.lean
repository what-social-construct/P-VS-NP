module

public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.RingTheory.Ideal.Colon
public import Mathlib.RingTheory.Polynomial.Quotient

/-!
# The first-colon residual on a readout minor chart

After two difference coordinates are eliminated, the equal-readout equation
is `d * X = 0` and the diagonal has equation `X = 0`. The coefficient ring
may contain the first direction variables and may be nonreduced.
-/

@[expose] public section

namespace PvsNP.ReadoutResidual

open Polynomial

variable {R S : Type*} [CommRing R] [CommRing S]

section

variable {A : Type*} [CommRing A]

/--
The pullback of the annihilator of `J/I` is the colon ideal `I : J`.
-/
theorem comap_annihilator_map_quotient_eq_colon
    (I J : Ideal A) :
    ((J.map (Ideal.Quotient.mk I)).annihilator).comap
        (Ideal.Quotient.mk I) =
      I.colon J := by
  ext x
  constructor
  · intro hx
    rw [Submodule.mem_colon]
    intro j hj
    have hzero :
        Ideal.Quotient.mk I x *
            Ideal.Quotient.mk I j = 0 := by
      exact
        Submodule.mem_annihilator.mp hx _
          (Ideal.mem_map_of_mem (Ideal.Quotient.mk I) hj)
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hzero
    exact hzero
  · intro hx
    apply Submodule.mem_annihilator.mpr
    intro z hz
    obtain ⟨j, hj, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective
        (Ideal.Quotient.mk I)
        Ideal.Quotient.mk_surjective).mp hz
    change
      Ideal.Quotient.mk I x *
          Ideal.Quotient.mk I j = 0
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Submodule.mem_colon.mp hx j hj

end

/-- Cancel the remaining difference variable in the first colon ideal. -/
theorem normalForm_colon (d : R) :
    (Ideal.span {C d * X}).colon (Ideal.span {(X : R[X])}) = Ideal.span {C d} := by
  ext p
  rw [Ideal.mem_colon_span_singleton, Ideal.mem_span_singleton', Ideal.mem_span_singleton']
  constructor
  · rintro ⟨q, hq⟩
    exact ⟨q, isRegular_X.right (by simpa only [mul_assoc] using hq)⟩
  · rintro ⟨q, rfl⟩
    exact ⟨q, (mul_assoc _ _ _).symm⟩

/-- In the equal-readout quotient, the pullback of the annihilator of the
diagonal ideal is generated by the determinant. -/
theorem normalForm_diagonal_annihilator (d : R) :
    let q := Ideal.Quotient.mk (Ideal.span {C d * X})
    (((Ideal.span {(X : R[X])}).map q).annihilator).comap q = Ideal.span {C d} :=
  (comap_annihilator_map_quotient_eq_colon _ _).trans (normalForm_colon d)

private theorem colon_comap_of_surjective (f : S →+* R) (hf : Function.Surjective f)
    (I J : Ideal R) :
    (I.comap f).colon (J.comap f) = (I.colon J).comap f := by
  ext x
  simp only [Ideal.mem_comap, Submodule.mem_colon, SetLike.mem_coe, smul_eq_mul]
  constructor
  · intro hx y hy
    obtain ⟨z, rfl⟩ := hf y
    simpa only [map_mul] using hx z hy
  · intro hx y hy
    simpa only [map_mul] using hx (f y) hy

private theorem comap_span_image (f : S →+* R) (hf : Function.Surjective f) (a : S) :
    (Ideal.span {f a}).comap f = Ideal.span {a} ⊔ RingHom.ker f := by
  simpa only [Ideal.map_span, Set.image_singleton, RingHom.ker_eq_comap_bot] using
    Ideal.comap_map_of_surjective f hf (Ideal.span {a})

/-- Lift the normal form before eliminating the two coordinates.
`ker π` is the ideal of those coordinates, `x` is the last difference
coordinate and `b` lifts the determinant up to the chosen unit. -/
theorem lifted_colon (π : S →+* R[X]) (hπ : Function.Surjective π)
    {b x : S} {d : R} (hb : π b = C d) (hx : π x = X) :
    (Ideal.span {b*x} ⊔ RingHom.ker π).colon ((Ideal.span {x} ⊔ RingHom.ker π : Ideal S) : Set S) =
      Ideal.span {b} ⊔ RingHom.ker π := by
  rw [← comap_span_image π hπ (b*x), ← comap_span_image π hπ x,
    ← comap_span_image π hπ b, map_mul, hb, hx, colon_comap_of_surjective,
    normalForm_colon]
  exact hπ

/-- In three explicit difference coordinates the equal-readout ideal
is `(z, y, d * x)` and its first colon by `(z, y, x)` is `(z, y, d)`.
The innermost polynomial variable is `x`. -/
theorem threeCoordinate_colon (d : R) :
    let K : Ideal R[X][X][X] := Ideal.span {C X, X}
    let x : R[X][X][X] := C (C X)
    let b : R[X][X][X] := C (C (C d))
    (Ideal.span {b*x} ⊔ K).colon ((Ideal.span {x} ⊔ K : Ideal R[X][X][X]) : Set _) =
      Ideal.span {b} ⊔ K := by
  let π : R[X][X][X] →+* R[X] := (evalRingHom 0).comp (evalRingHom 0)
  have hπ : Function.Surjective π := fun p ↦ ⟨C (C p), by simp [π]⟩
  have hker : RingHom.ker π = Ideal.span {C X, X} := by
    ext p
    simpa [π, RingHom.mem_ker] using
      (mem_span_C_X_sub_C_X_sub_C_iff_eval_eval_eq_zero (P := p) (a := 0) (b := 0)).symm
  simpa only [hker] using lifted_colon π hπ (b := C (C (C d))) (x := C (C X))
    (d := d) (by simp [π]) (by simp [π])

/-- Taking the first colon commutes with every coefficient-ring morphism. -/
theorem map_normalForm_colon (f : R →+* S) (d : R) :
    ((Ideal.span {C d * X}).colon (Ideal.span {(X : R[X])})).map (mapRingHom f) =
      (Ideal.span {C (f d) * X}).colon (Ideal.span {(X : S[X])}) := by
  simp only [normalForm_colon, Ideal.map_span, Set.image_singleton, coe_mapRingHom, map_C]

/-- The residual algebra is the polynomial algebra in the difference coordinate
over the determinant quotient. -/
noncomputable def normalForm_quotientEquiv (d : R) :
    (R[X] ⧸ (Ideal.span {C d * X}).colon (Ideal.span {(X : R[X])})) ≃+*
      (R ⧸ Ideal.span {d})[X] := by
  refine (Ideal.quotEquivOfEq ?_).trans
    (Ideal.polynomialQuotientEquivQuotientPolynomial (Ideal.span {d})).symm
  rw [normalForm_colon, Ideal.map_span, Set.image_singleton]

/-- Inverting the difference coordinate on the residual gives the same kernel
as the first colon in the polynomial ring of pairs. -/
theorem puncturedLine_ker (d : R) :
    RingHom.ker (toLaurent.comp (mapRingHom (Ideal.Quotient.mk (Ideal.span {d})))) =
      (Ideal.span {C d * X}).colon (Ideal.span {(X : R[X])}) := by
  calc
    _ = RingHom.ker (mapRingHom (Ideal.Quotient.mk (Ideal.span {d}))) := by
      ext p
      simp only [RingHom.mem_ker, RingHom.comp_apply, toLaurent_eq_zero]
    _ = _ := by
      rw [Polynomial.ker_mapRingHom, Ideal.mk_ker, Ideal.map_span,
        Set.image_singleton, normalForm_colon]

/-- The punctured pairs have free first-direction coordinates and an invertible
difference coordinate. The kernel of their base map gives the scheme-theoretic
image, including the determinant scheme structure over a nonreduced base. -/
theorem puncturedPairs_base_ker (σ : Type*) (d : R) :
    RingHom.ker (toLaurent.comp (C.comp ((MvPolynomial.C (σ := σ)).comp
      (Ideal.Quotient.mk (Ideal.span {d}))))) =
      Ideal.span {d} := by
  ext a
  simp only [RingHom.mem_ker, RingHom.comp_apply, toLaurent_eq_zero,
    C_eq_zero, MvPolynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem]

end PvsNP.ReadoutResidual

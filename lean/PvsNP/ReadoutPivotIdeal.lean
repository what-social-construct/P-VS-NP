module

public import PvsNP.ReadoutResidual
import Mathlib.Tactic.Ring

/-! # The readout ideal in raw coordinates on a Schur-complement chart -/

@[expose] public section

namespace PvsNP.ReadoutResidual

set_option maxHeartbeats 1000000

open Polynomial

variable {R : Type*} [CommRing R]

/-- An invertible two-row change preserves the ideal generated by the rows. -/
theorem pivotPair_span (i j k l y z : R) (h : IsUnit (i*l-j*k)) :
    Ideal.span {i*y+j*z, k*y+l*z} = Ideal.span {y,z} := by
  apply le_antisymm <;> apply Ideal.span_le.mpr <;> rw [Set.pair_subset_iff]
  · exact ⟨Ideal.mem_span_pair.mpr ⟨i, j, rfl⟩, Ideal.mem_span_pair.mpr ⟨k, l, rfl⟩⟩
  · constructor
    · apply (Ideal.unit_mul_mem_iff_mem _ h).mp
      exact Ideal.mem_span_pair.mpr ⟨l, -j, by ring⟩
    · apply (Ideal.unit_mul_mem_iff_mem _ h).mp
      exact Ideal.mem_span_pair.mpr ⟨-k, i, by ring⟩

private theorem shifted_diagonal (x y z a b : R) :
    Ideal.span {x} ⊔ Ideal.span {y+a*x, z+b*x} = Ideal.span {x} ⊔ Ideal.span {y,z} := by
  have forward (u v c d : R) : Ideal.span {x} ⊔ Ideal.span {u+c*x,v+d*x} ≤
      Ideal.span {x} ⊔ Ideal.span {u,v} := by
    apply sup_le le_sup_left
    apply Ideal.span_le.mpr
    rw [Set.pair_subset_iff]
    have hx := (le_sup_left : Ideal.span {x} ≤ Ideal.span {x} ⊔ Ideal.span {u,v})
      (Ideal.mem_span_singleton_self x)
    have hu := (le_sup_right : Ideal.span {u,v} ≤ Ideal.span {x} ⊔ Ideal.span {u,v})
      (Ideal.subset_span (Set.mem_insert u {v}))
    have hv := (le_sup_right : Ideal.span {u,v} ≤ Ideal.span {x} ⊔ Ideal.span {u,v})
      (Ideal.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton v)))
    exact ⟨add_mem hu (Ideal.mul_mem_left _ c hx), add_mem hv (Ideal.mul_mem_left _ d hx)⟩
  exact le_antisymm (forward y z a b) (by simpa using forward (y+a*x) (z+b*x) (-a) (-b))

/-- Use the two raw differences `y,z` and the remaining difference `x`.
The pivoted rows are `y+a*x` and `z+b*x`, and the third row is completely
arbitrary. The first colon keeps the first two equations and replaces the
third by its Schur complement. -/
theorem rawPivot_colon (a b c d e : R) :
    let C₃ : R →+* R[X][X][X] := C.comp (C.comp C)
    let x : R[X][X][X] := C (C X)
    let y : R[X][X][X] := C X
    let z : R[X][X][X] := X
    let K := Ideal.span {y + C₃ a*x, z + C₃ b*x}
    let I := Ideal.span {C₃ c*y + C₃ d*z + C₃ e*x} ⊔ K
    let J : Ideal R[X][X][X] := Ideal.span {x} ⊔ Ideal.span {y,z}
    I.colon (J : Set _) = Ideal.span {C₃ (e-c*a-d*b)} ⊔ K := by
  let C₃ : R →+* R[X][X][X] := C.comp (C.comp C)
  let x : R[X][X][X] := C (C X)
  let y : R[X][X][X] := C X
  let z : R[X][X][X] := X
  let K := Ideal.span {y + C₃ a*x, z + C₃ b*x}
  let r := C₃ c*y + C₃ d*z + C₃ e*x
  let s := e-c*a-d*b
  let π : R[X][X][X] →+* R[X] :=
    (evalRingHom (-(C a * X))).comp (evalRingHom (C (-(C b * X))))
  have hπ : Function.Surjective π := fun p ↦ ⟨C (C p), by simp [π]⟩
  let F : R[X] →+* R[X][X][X] := C.comp C
  have eqy : (C (X - C (-(C a * X))) : R[X][X][X]) = y + C₃ a*x := by
    rw [C_neg, sub_neg_eq_add, C_add]
    exact congrArg (y + ·) (map_mul F (C a) X)
  have eqz : (X - C (C (-(C b * X))) : R[X][X][X]) = z + C₃ b*x := by
    change z - F (-(C b * X)) = _
    rw [map_neg, sub_neg_eq_add, map_mul F]
    rfl
  have hker : RingHom.ker π = K := by
    ext p
    change (p.eval (C (-(C b * X)))).eval (-(C a * X)) = 0 ↔ p ∈ K
    rw [← mem_span_C_X_sub_C_X_sub_C_iff_eval_eval_eq_zero, eqy, eqz]
  have hx : π x = X := by simp [π, x]
  have hs : π (C₃ s) = C s := by simp [π, C₃]
  have hy : π y = -(C a * X) := by simp [π, y]
  have hz : π z = -(C b * X) := by simp [π, z]
  have hconst (t : R) : π (C₃ t) = C t := by simp [π, C₃]
  have hr : π r = π (C₃ s*x) := by
    simp only [r, s, map_add, map_mul, map_sub, hconst, hx, hy, hz]
    ring
  have lift (p : R[X][X][X]) : (Ideal.span {π p}).comap π = Ideal.span {p} ⊔ K := by
    calc
      _ = ((Ideal.span {p}).map π).comap π := by rw [Ideal.map_span, Set.image_singleton]
      _ = Ideal.span {p} ⊔ RingHom.ker π := Ideal.comap_map_of_surjective π hπ _
      _ = _ := congrArg (fun J => Ideal.span {p} ⊔ J) hker
  have heq : Ideal.span {r} ⊔ K = Ideal.span {C₃ s*x} ⊔ K :=
    (lift r).symm.trans ((congrArg (fun t => (Ideal.span {t}).comap π) hr).trans (lift _))
  have result := lifted_colon (R := R) (S := R[X][X][X]) π hπ
    (b := C₃ s) (x := x) (d := s) hs hx
  rw [hker] at result
  exact (congrArg₂ (fun (I J : Ideal R[X][X][X]) => I.colon (J : Set _)) heq
    (shifted_diagonal x y z (C₃ a) (C₃ b)).symm).trans result

/-- The three raw readout equations for the matrix with rows
`(i,j,p), (k,l,q), (c,d,e)`. On its leading unit-minor chart the
first colon keeps the first two rows and replaces the third by the
full three-by-three determinant. -/
theorem rawReadout_colon (i j p k l q c d e : R) (h : IsUnit (i*l-j*k)) :
    let B : R →+* R[X][X][X] := C.comp (C.comp C)
    let x : R[X][X][X] := C (C X)
    let y : R[X][X][X] := C X
    let z : R[X][X][X] := X
    let K := Ideal.span {B i*y+B j*z+B p*x, B k*y+B l*z+B q*x}
    let I := Ideal.span {B c*y+B d*z+B e*x} ⊔ K
    let J : Ideal R[X][X][X] := Ideal.span {x} ⊔ Ideal.span {y,z}
    I.colon (J : Set _) =
      Ideal.span {B (i*(l*e-q*d)-j*(k*e-q*c)+p*(k*d-l*c))} ⊔ K := by
  let B : R →+* R[X][X][X] := C.comp (C.comp C)
  let x : R[X][X][X] := C (C X)
  let y : R[X][X][X] := C X
  let z : R[X][X][X] := X
  obtain ⟨u, hu⟩ := h
  let a := (↑u⁻¹ : R)*(l*p-j*q)
  let b := (↑u⁻¹ : R)*(i*q-k*p)
  have hp : i*a+j*b=p := by
    calc
      _ = (↑u⁻¹ : R)*((i*l-j*k)*p) := by dsimp [a,b]; ring
      _ = p := by rw [← hu, ← mul_assoc, Units.inv_mul, one_mul]
  have hq : k*a+l*b=q := by
    calc
      _ = (↑u⁻¹ : R)*((i*l-j*k)*q) := by dsimp [a,b]; ring
      _ = q := by rw [← hu, ← mul_assoc, Units.inv_mul, one_mul]
  have hdet : i*(l*e-q*d)-j*(k*e-q*c)+p*(k*d-l*c) = (i*l-j*k)*(e-c*a-d*b) := by
    rw [← hp, ← hq]
    ring
  have hrow₀ : B i*y+B j*z+B p*x = B i*(y+B a*x)+B j*(z+B b*x) := by
    rw [← hp, map_add, map_mul B i a, map_mul B j b]; ring
  have hrow₁ : B k*y+B l*z+B q*x = B k*(y+B a*x)+B l*(z+B b*x) := by
    rw [← hq, map_add, map_mul B k a, map_mul B l b]; ring
  have hm : IsUnit (B (i*l-j*k)) := (hu ▸ u.isUnit).map B
  have hrows := pivotPair_span (B i) (B j) (B k) (B l) (y+B a*x) (z+B b*x)
    (by simpa only [map_sub,map_mul] using hm)
  dsimp only
  change (Ideal.span {B c*y+B d*z+B e*x} ⊔ _).colon
    ((Ideal.span {x} ⊔ Ideal.span {y,z} : Ideal _) : Set _) = Ideal.span {B _} ⊔ _
  rw [hrow₀, hrow₁, hrows, hdet, map_mul B (i*l-j*k) (e-c*a-d*b),
    Ideal.span_singleton_mul_left_unit hm]
  exact rawPivot_colon a b c d e

end PvsNP.ReadoutResidual
